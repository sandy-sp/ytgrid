# YTGrid General Settings
YTGRID_API_KEY=your_secure_api_key_here
YTGRID_API_BASE_URL=http://127.0.0.1:8000
YTGRID_CORS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,https://tauri.localhost,http://tauri.localhost
YTGRID_HEADLESS_MODE=True
YTGRID_DEFAULT_SPEED=1.0
YTGRID_DEFAULT_LOOP_COUNT=1

# Session Management
YTGRID_MAX_SESSIONS=5

# WebSocket / SSE
YTGRID_REALTIME_UPDATES=False
YTGRID_WEBSOCKET_SERVER_URL=ws://127.0.0.1:8000/ws

# Browser Settings
YTGRID_USE_TEMP_USER_DATA=True
YTGRID_BROWSER_TIMEOUT=20

# Database
YTGRID_DB_PATH=ytgrid/ytgrid.db

# Resource Optimizer
YTGRID_OPTIMIZER_ENABLED=True
YTGRID_TMP_MAX_AGE=1800

# Proxy Rotation
YTGRID_PROXY_ENABLED=False
YTGRID_PROXY_SOURCE=file
YTGRID_PROXY_FILE=./proxies.txt
YTGRID_PROXY_API_URL=
YTGRID_PROXY_API_KEY=
YTGRID_PROXY_COOLDOWN_SECONDS=300
YTGRID_PROXY_HEALTH_CHECK_INTERVAL=60
YTGRID_PROXY_MAX_FAILURE_RATE=0.3

# Celery Integration
# Background Task Runner
# Set to True if using Docker Compose / Celery / Redis
YTGRID_USE_CELERY=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
